# TalentLens Environment Variables
# Do NOT hardcode actual API keys here.

# Database
POSTGRES_USER=talentlens
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=talentlens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_secure_password

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000

# API Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Optional External API Keys (Local-first deterministic models are used by default)
OPENAI_API_KEY=
GEMINI_API_KEY=
